[Unit]
Description=TailOps Linux Fleet observation
Documentation=https://github.com/StoneHub/tailops-monitor
Requires=tailscaled.service
After=tailscaled.service
ConditionPathExists=/opt/tailopsd/current/bin/tailopsd.js

[Service]
Type=oneshot
User=tailopsd
Group=tailopsd
WorkingDirectory=/var/lib/tailopsd
ExecStart=/opt/tailopsd/current/bin/tailopsd.js snapshot --output /var/lib/tailopsd/fleet-observation.json --health-output /var/lib/tailopsd/host-health.json
TimeoutStartSec=60s
UMask=0077

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/tailopsd
CapabilityBoundingSet=
AmbientCapabilities=

# Run only on spare capacity. The quota is a runaway guard, not a pacing limit: a
# tailnet listing hundreds of provider peers needs about a second of CPU to read.
Nice=19
CPUSchedulingPolicy=idle
IOSchedulingClass=idle
CPUQuota=50%
MemoryMax=128M
TasksMax=32

{
  "name": "tailops-monitor",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "macOS-first Tailscale companion: a WidgetKit widget with a hidden Swift host app, plus a read-only Linux Fleet observation CLI.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "npm run test:linux",
    "test:linux": "npm --prefix platforms/linux/tailopsd test",
    "pack:linux": "npm --prefix platforms/linux/tailopsd run pack:linux"
  },
  "keywords": [
    "tailscale",
    "macos",
    "widgetkit",
    "fleet",
    "homelab"
  ],
  "license": "MIT"
}
